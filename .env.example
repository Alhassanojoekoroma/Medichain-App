# PalmChain mobile client environment (non-secret values only)
# Copy to .env.local for local development. Never place provider credentials,
# private keys, database URLs, or server signing secrets in an Expo environment.

EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_DATA_CLASSIFICATION=synthetic
EXPO_PUBLIC_APP_NAME=PalmChain Synthetic Sandbox
# Password entry is permitted only in an explicit synthetic sandbox. Omit this
# value in managed builds so the app fails closed until a provider SDK is wired.
EXPO_PUBLIC_IDENTITY_MODE=sandbox

# Disable the Expo doctor network validation for local development to avoid Expo CLI fetch failures.
EXPO_NO_DOCTOR=true
