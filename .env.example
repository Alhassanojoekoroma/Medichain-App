# MediChain SL — Environment Variables
# Copy this file to .env and fill in real values before production builds.
# NEVER commit real keys to git.

# ─── AI Integration ─────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Backend API ─────────────────────────────────────────────────────────────
# MediChain backend gateway (node backend/api/index.js)
API_BASE_URL=http://localhost:3000
API_TIMEOUT_MS=10000

# ─── Blockchain (Hyperledger Fabric) ────────────────────────────────────────
# These are read by the backend API (backend/api/.env), NOT the frontend.
# Channel name and chaincode IDs must match what was committed during deploy.
HLF_CHANNEL_NAME=medichainchannel
HLF_PATIENT_CC=patient
HLF_DOCTOR_CC=doctor
HLF_AUDIT_CC=audit

# ─── IPFS ────────────────────────────────────────────────────────────────────
# Local IPFS daemon API (port 5001) — start IPFS Desktop to enable this.
IPFS_API_URL=http://127.0.0.1:5001
# Local IPFS gateway for file retrieval
IPFS_GATEWAY_URL=http://127.0.0.1:8080/ipfs/
# Optional Pinata cloud fallback (leave blank to use local daemon only)
PINATA_JWT=YOUR_PINATA_JWT_HERE
