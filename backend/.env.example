# PalmChain backend runtime configuration
# Supply secrets through an approved runtime secret store. Keep this file empty
# of real credentials and never copy production values into source control.

APP_ENVIRONMENT=sandbox
DATA_CLASSIFICATION=synthetic
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

JWT_SECRET=
QR_TOKEN_SECRET=
AUDIT_PEPPER=
JWT_EXPIRY=15m
SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
DATABASE_URL=

# Use sandbox only with explicit demo authentication. Approved deployments use
# oidc and supply an HTTPS issuer/JWKS endpoint from the selected identity owner.
IDENTITY_PROVIDER_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
# These claims must be populated by a privileged provider hook/action and must
# never come from user-editable profile metadata.
OIDC_ACTOR_ID_CLAIM=https://palmchain.health/actor_id
OIDC_ROLE_CLAIM=https://palmchain.health/role
OIDC_STATUS_CLAIM=https://palmchain.health/status
OIDC_FACILITY_ID_CLAIM=https://palmchain.health/facility_id
OIDC_TOKEN_VERSION_CLAIM=https://palmchain.health/token_version
OIDC_MFA_ACR_VALUES=
OIDC_MAX_TOKEN_AGE_SECONDS=900
OIDC_CLOCK_TOLERANCE_SECONDS=30

# Explicit sandbox-only switches. All three are rejected outside a synthetic
# sandbox. Leave false unless the environment contains synthetic data only.
ALLOW_SIMULATION=false
ENABLE_DEMO_AUTH=false
ENABLE_DEMO_DATA=false
SANDBOX_PATIENT_PASSWORD=

# Fabric is disabled by default. Real mode requires runtime-mounted identity
# files that are not stored in this repository.
FABRIC_MODE=disabled
FABRIC_PEER_ENDPOINT=
FABRIC_MSP_ID=
FABRIC_TLS_CA_PATH=
FABRIC_CERT_PATH=
FABRIC_PRIVATE_KEY_PATH=
FABRIC_CHANNEL=medichain
FABRIC_ORGANIZATION=
FABRIC_POLICY_VERSION=v1
FABRIC_ANCHOR_DIGEST_SECRET=

# Medical files are uploaded directly to a KMS-encrypted quarantine bucket,
# scanned by ClamAV, and promoted to a separate clean bucket. Bucket names,
# object keys, and KMS identifiers are server-side only.
AWS_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
MEDICAL_QUARANTINE_BUCKET=
MEDICAL_CLEAN_BUCKET=
MEDICAL_KMS_KEY_ID=
CLAMAV_HOST=
CLAMAV_PORT=3310

# Enable only in the dedicated API/worker process after Postgres, storage,
# ClamAV, Fabric, audit secrets, and notification operations are configured.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_INTERVAL_MS=5000

# Responsible AI remains off by default. This flag enables only the local,
# deterministic synthetic documentation provider in an explicit sandbox.
# No external AI provider credential belongs in this repository or a client.
AI_ASSISTANT_ENABLED=false
