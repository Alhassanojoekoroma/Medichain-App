PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your_at_api_key_here

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/medichain

# IPFS / Web3.Storage
# Get token from: https://web3.storage/
WEB3_STORAGE_TOKEN=your_web3_storage_token_here
IPFS_GATEWAY_URL=https://w3s.link/ipfs/

# Hyperledger Fabric
FABRIC_CONNECTION_PROFILE=../../medichain-network/connection-profile.json
FABRIC_WALLET_PATH=./wallet
FABRIC_LOCALNET=true
FABRIC_CHANNEL=medichain

# Legacy (can be deprecated)
HLF_CONNECTION_PROFILE=./connection.json
HLF_WALLET_PATH=./wallet
HLF_CHANNEL_NAME=medichainchannel
